PORT=3000
DB_PATH=./data/orders.sqlite
NODE_ENV=development
TRUST_PROXY_HOPS=0
FRONTEND_URL=https://tu-sitio-de-prueba.example
PUBLIC_API_URL=
CORS_ORIGIN=https://tu-sitio-de-prueba.example
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
ADMIN_PASSWORD=
ORDER_RESERVATION_MINUTES=30
# Carpeta para imágenes subidas desde el panel (opcional).
# Por defecto: ./data/uploads (junto a la base de datos).
UPLOAD_DIR=
# Carpeta de respaldos verificables de la base (Etapa 5): se copia la base
# antes de importaciones y cambios masivos. Por defecto: ./data/backups
# (junto a la base de datos). Solo se conservan los últimos 30.
BACKUP_DIR=

# ---------------------------------------------------------------------------
# DEMO LOCAL (cuando todavía no hay dominio HTTPS)
# ---------------------------------------------------------------------------
# Para probar la tienda contra el backend en tu máquina:
#
# 1) Si abrís la tienda con un servidor estático local (recomendado):
#      python -m http.server 8080 --bind 127.0.0.1
#    y el backend con:
#      node server/index.js
#    entonces CORS_ORIGIN debe incluir ese origen:
#      CORS_ORIGIN=http://127.0.0.1:8080,http://localhost:8080
#
# 2) Si abrís index.html directamente con doble clic (protocolo file://),
#    el navegador envía origen "null", que también hay que permitir:
#      CORS_ORIGIN=null,http://127.0.0.1:8080,http://localhost:8080
#
# En NODE_ENV=development no se exige HTTPS ni dominio real. Pasá a
# production solo cuando tengas el servidor publicado con HTTPS.
# ADMIN_PASSWORD: contraseña para entrar a /admin (mínimo 16 caracteres).
